# 참고용 예제입니다. 실제 인증 정보를 커밋하지 마세요.
# DB 연결 시 프로젝트 루트의 .env를 읽습니다. 기존 프로세스 환경변수가 우선합니다.
# 서버·DB·Slack 앱과 테이블은 이 프로젝트가 자동 생성하지 않습니다.
DB_ENGINE=postgresql
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSLMODE=verify-full
DB_SSLROOTCERT=runtime/certs/aiven-ca.pem
# 파일 대신 CA PEM 본문을 비밀 설정으로 전달할 때만 사용합니다. 둘 다 지정하면 PEM 우선.
DB_SSLROOTCERT_PEM=

# 이전할 로컬 원본 MariaDB. 이전 도구에서만 사용하며 쓰기를 하지 않습니다.
SOURCE_DB_HOST=127.0.0.1
SOURCE_DB_PORT=3306
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_DB_NAME=crawling

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_CU=
SLACK_CHANNEL_GS25=
SLACK_CHANNEL_SEVEN=
SLACK_CHANNEL_YOUTUBE=
SLACK_CHANNEL_NEWS=
SLACK_CHANNEL_ALERT=
# 비워두면 기존 이상치 채널에 [시뮬레이션] 표시로 전송합니다.
SLACK_CHANNEL_SIMULATION=
SLACK_CHANNEL_TABLEAU=
TABLEAU_DASHBOARD_URL=
TABLEAU_TP_URL=
# Streamlit 배포 후 https://...streamlit.app 주소를 설정합니다.
DASHBOARD_URL=
# Slack 홈 그래프 이미지 제공용 Render 서비스 기본 주소 (https://...onrender.com).
SLACK_PUBLIC_BASE_URL=

# ChromeDriver 경로. 비워두면 Selenium 기본 탐색 사용.
CHROMEDRIVER_PATH=
