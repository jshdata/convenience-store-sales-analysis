# 참고용 예제입니다. 실제 인증 정보를 커밋하지 마세요.
# .env는 자동 로드되지 않습니다. 실행 전에 프로세스 환경변수로 설정하세요.
# 서버·DB·Slack 앱과 테이블은 이 프로젝트가 자동 생성하지 않습니다.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_CU=
SLACK_CHANNEL_GS25=
SLACK_CHANNEL_SEVEN=
SLACK_CHANNEL_YOUTUBE=
SLACK_CHANNEL_NEWS=
SLACK_CHANNEL_ALERT=
SLACK_CHANNEL_TABLEAU=
TABLEAU_DASHBOARD_URL=
TABLEAU_TP_URL=

# ChromeDriver 경로. 비워두면 Selenium 기본 탐색 사용.
CHROMEDRIVER_PATH=
